{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noel-method.example/schemas/policy-authorities.schema.json",
  "title": "Noel Method PolicyAuthorityRegistry",
  "type": "object",
  "propertyNames": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "policy_id",
      "method_version",
      "policy_sha256",
      "authority_source",
      "accepted_by",
      "accepted_at"
    ],
    "properties": {
      "policy_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "method_version": {
        "type": "string",
        "pattern": "^0\\.4\\.[0-9]+$"
      },
      "policy_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "authority_source": {
        "type": "string",
        "minLength": 1
      },
      "accepted_by": {
        "type": "string",
        "minLength": 1
      },
      "accepted_at": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
