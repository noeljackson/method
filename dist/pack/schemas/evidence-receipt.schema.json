{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noeljackson/method/schemas/evidence-receipt.schema.json",
  "title": "Noel Method EvidenceReceipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "durability_reason",
    "subject_identity",
    "environment_identity",
    "procedure",
    "claims",
    "evidence_ref",
    "captured_at",
    "limitations",
    "source_disposition"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "durability_reason": {
      "enum": [
        "ephemeral",
        "destructive_output",
        "secret_reduced",
        "successor_gap"
      ]
    },
    "subject_identity": {
      "type": "string",
      "pattern": "\\S"
    },
    "environment_identity": {
      "type": "string",
      "pattern": "\\S"
    },
    "procedure": {
      "type": "string",
      "pattern": "\\S"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "outcome",
          "observation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "outcome": {
            "enum": [
              "SUPPORTED",
              "REJECTED",
              "INCONCLUSIVE"
            ]
          },
          "observation": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "\\S"
    },
    "captured_at": {
      "type": "string",
      "pattern": "\\S"
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "source_disposition": {
      "enum": [
        "not_sensitive",
        "retained_protected",
        "reduced_and_destroyed"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S"
    }
  }
}
