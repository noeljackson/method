{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noel-method.example/schemas/evidence-receipt.schema.json",
  "title": "Noel Method EvidenceReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim",
    "observation",
    "artifact_identity",
    "environment_identity",
    "method",
    "result",
    "citation",
    "captured_at",
    "limitations",
    "superseded_by"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "artifact_identity": {
      "type": "string",
      "minLength": 1
    },
    "environment_identity": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "minLength": 1
    },
    "citation": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": "string",
      "minLength": 1
    }
  }
}
