{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noel-method.example/schemas/resolved-permissions.schema.json",
  "title": "Noel Method ResolvedPermissions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_version",
    "authority_mode",
    "task_id",
    "task_sha256",
    "policy_verified",
    "policy_ref",
    "canonical_sources",
    "allowed_actions",
    "forbidden_actions",
    "protocols",
    "required_gates",
    "controls"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "method_version": {
      "type": "string",
      "pattern": "^0\\.4\\.[0-9]+$"
    },
    "authority_mode": {
      "const": "resolved"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_verified": {
      "const": true
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "policy_sha256",
        "acceptance_receipt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "acceptance_receipt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "canonical_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owns",
          "precedence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owns": {
            "type": "string",
            "minLength": 1
          },
          "precedence": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "allowed_actions": {
      "$ref": "#/$defs/stringArray"
    },
    "forbidden_actions": {
      "$ref": "#/$defs/stringArray"
    },
    "protocols": {
      "type": "array",
      "items": {
        "enum": [
          "program",
          "experiment",
          "secrets"
        ]
      },
      "uniqueItems": true
    },
    "required_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "default",
          "before",
          "required_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "default": {
            "type": "boolean"
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "properties": {
        "reporting": {
          "type": "string",
          "minLength": 1
        },
        "program_repair_authority": {
          "type": "string",
          "minLength": 1
        },
        "secrets": {
          "type": "object"
        }
      },
      "required": [
        "reporting"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
