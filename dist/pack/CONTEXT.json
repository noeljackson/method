{
  "authority_modes": {
    "default": "direct",
    "direct": {
      "requires": []
    },
    "resolved": {
      "requires": [
        "TaskRequest",
        "ResolvedPermissions"
      ],
      "selection": "explicit"
    }
  },
  "kernel": "KERNEL.md",
  "module_order": [
    "protocols/program.md",
    "protocols/experiment.md",
    "protocols/secrets.md"
  ],
  "protocols": {
    "experiment": {
      "module": "protocols/experiment.md",
      "task_signal": "controlled_comparison"
    },
    "program": {
      "module": "protocols/program.md",
      "task_signal": "persistent_program"
    },
    "secrets": {
      "module": "protocols/secrets.md",
      "task_signal": "secret_risk"
    }
  },
  "resolved_mode": {
    "authorities_schema": "schemas/policy-authorities.schema.json",
    "evidence_schema": "schemas/evidence-receipt.schema.json",
    "permissions_schema": "schemas/resolved-permissions.schema.json",
    "policy_schema": "schemas/project-policy.schema.json",
    "program_schema": "schemas/program-control.schema.json",
    "task_schema": "schemas/task-request.schema.json"
  },
  "schema_version": 3
}
