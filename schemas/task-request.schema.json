{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noel-method.example/schemas/task-request.schema.json",
  "title": "Noel Method TaskRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "outcome",
    "scope",
    "resource_refs",
    "requested_actions",
    "forbidden_actions",
    "signals",
    "required_gates",
    "baseline_identity",
    "stop_conditions",
    "expires_on"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "include": {
          "$ref": "#/$defs/stringArray"
        },
        "exclude": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "resource_refs": {
      "$ref": "#/$defs/stringArray"
    },
    "requested_actions": {
      "$ref": "#/$defs/stringArray"
    },
    "forbidden_actions": {
      "$ref": "#/$defs/stringArray"
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistent_program",
        "controlled_comparison",
        "secret_risk"
      ],
      "properties": {
        "persistent_program": {
          "type": "boolean"
        },
        "controlled_comparison": {
          "type": "boolean"
        },
        "secret_risk": {
          "enum": [
            "none",
            "possible",
            "required"
          ]
        }
      }
    },
    "required_gates": {
      "$ref": "#/$defs/stringArray"
    },
    "baseline_identity": {
      "type": "string",
      "minLength": 1
    },
    "stop_conditions": {
      "$ref": "#/$defs/stringArray"
    },
    "expires_on": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
