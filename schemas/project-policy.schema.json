{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noel-method.example/schemas/project-policy.schema.json",
  "title": "Noel Method ProjectPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_version",
    "policy_id",
    "policy",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "method_version": {
      "type": "string",
      "pattern": "^0\\.5\\.[0-9]+$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "canonical_sources",
        "actions",
        "protocols",
        "gates",
        "secrets",
        "program",
        "reporting"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/stringArray"
        },
        "canonical_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "owns",
              "precedence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "owns": {
                "type": "string",
                "minLength": 1
              },
              "precedence": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "forbidden"
          ],
          "properties": {
            "allowed": {
              "$ref": "#/$defs/stringArray"
            },
            "forbidden": {
              "$ref": "#/$defs/stringArray"
            }
          }
        },
        "protocols": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "program",
            "experiment",
            "secrets"
          ],
          "properties": {
            "program": {
              "type": "boolean"
            },
            "experiment": {
              "type": "boolean"
            },
            "secrets": {
              "type": "boolean"
            }
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "default",
              "before",
              "required_evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "default": {
                "type": "boolean"
              },
              "before": {
                "type": "string",
                "minLength": 1
              },
              "required_evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "routine_access",
            "approved_references",
            "delivery",
            "artifact_scan",
            "exposure_response",
            "forensic_quarantine",
            "clean_context",
            "encrypted_envelopes"
          ],
          "properties": {
            "routine_access": {
              "type": "string",
              "minLength": 1
            },
            "approved_references": {
              "$ref": "#/$defs/stringArray"
            },
            "delivery": {
              "type": "string",
              "minLength": 1
            },
            "artifact_scan": {
              "type": "string",
              "minLength": 1
            },
            "exposure_response": {
              "type": "string",
              "minLength": 1
            },
            "forensic_quarantine": {
              "type": "string",
              "minLength": 1
            },
            "clean_context": {
              "type": "string",
              "minLength": 1
            },
            "encrypted_envelopes": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "program": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trigger",
            "repair_authority"
          ],
          "properties": {
            "trigger": {
              "type": "string",
              "minLength": 1
            },
            "repair_authority": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reporting": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policy_sha256",
        "authority_source",
        "accepted_by",
        "accepted_at",
        "receipt"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "accepted"
          ]
        },
        "policy_sha256": {
          "type": "string"
        },
        "authority_source": {
          "type": "string"
        },
        "accepted_by": {
          "type": "string"
        },
        "accepted_at": {
          "type": "string"
        },
        "receipt": {
          "type": "string"
        }
      }
    }
  }
}
