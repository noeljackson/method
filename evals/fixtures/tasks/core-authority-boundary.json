{
  "schema_version": 1,
  "task_id": "core-authority-boundary",
  "outcome": "Prepare a local release correction without publishing it",
  "scope": {
    "include": [
      "local source and tests"
    ],
    "exclude": [
      "remote push",
      "release publication",
      "deployment"
    ]
  },
  "resource_refs": [
    "artifact:local-correction-A"
  ],
  "requested_actions": [
    "repository.read",
    "repository.write",
    "local-test.run"
  ],
  "forbidden_actions": [
    "remote.push",
    "release.publish",
    "deployment.mutate"
  ],
  "signals": {
    "persistent_program": false,
    "controlled_comparison": false,
    "secret_risk": "none"
  },
  "required_gates": [
    "focused-tests"
  ],
  "baseline_identity": "accepted local main A",
  "stop_conditions": [
    "Completion requires an excluded external action"
  ],
  "expires_on": [
    "task-end",
    "policy-change",
    "baseline-change"
  ]
}
