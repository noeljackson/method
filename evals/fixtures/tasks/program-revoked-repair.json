{
  "schema_version": 1,
  "task_id": "program-revoked-repair",
  "outcome": "Determine who may repair a stopped rollout control after owner revocation",
  "scope": {
    "include": [
      "read-only diagnosis",
      "authorized program repair proposal"
    ],
    "exclude": [
      "rollout dispatch",
      "self-authorization"
    ]
  },
  "resource_refs": [
    "program-control:rollout-A",
    "authority-record:sponsor-revocation-A"
  ],
  "requested_actions": [
    "operation.inspect",
    "program.plan"
  ],
  "forbidden_actions": [
    "program.self-authorize"
  ],
  "signals": {
    "persistent_program": true,
    "controlled_comparison": false,
    "secret_risk": "none"
  },
  "required_gates": [
    "operational-evidence"
  ],
  "baseline_identity": "stopped rollout control A",
  "stop_conditions": [
    "Repair authority depends on the invalidated control"
  ],
  "expires_on": [
    "task-end",
    "profile-change",
    "control-change"
  ]
}
