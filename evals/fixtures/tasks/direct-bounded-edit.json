{
  "schema_version": 1,
  "task_id": "direct-bounded-edit",
  "outcome": "Correct one local parser behavior and prove it with focused tests",
  "scope": {
    "include": [
      "parser source",
      "focused parser tests"
    ],
    "exclude": [
      "remote publication",
      "deployment"
    ]
  },
  "resource_refs": [
    "artifact:candidate-revision-A"
  ],
  "requested_actions": [
    "repository.read",
    "repository.write",
    "local-test.run"
  ],
  "forbidden_actions": [
    "remote.push"
  ],
  "signals": {
    "persistent_program": false,
    "controlled_comparison": false,
    "secret_risk": "none"
  },
  "required_gates": [
    "focused-tests"
  ],
  "baseline_identity": "candidate revision A",
  "stop_conditions": [
    "The change crosses the parser boundary or requires external mutation"
  ],
  "expires_on": [
    "task-end",
    "profile-change",
    "baseline-change"
  ]
}
