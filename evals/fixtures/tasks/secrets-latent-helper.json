{
  "schema_version": 1,
  "task_id": "secrets-latent-helper",
  "outcome": "Decide whether an undocumented diagnostic helper may run",
  "scope": {
    "include": [
      "helper inspection",
      "non-mutating risk classification"
    ],
    "exclude": [
      "credential retrieval",
      "remote publication"
    ]
  },
  "resource_refs": [
    "artifact:diagnostic-helper-A"
  ],
  "requested_actions": [
    "repository.read"
  ],
  "forbidden_actions": [
    "secret.read",
    "remote.push"
  ],
  "signals": {
    "persistent_program": false,
    "controlled_comparison": false,
    "secret_risk": "possible"
  },
  "required_gates": [
    "focused-tests"
  ],
  "baseline_identity": "undocumented helper revision A",
  "stop_conditions": [
    "Provider, credential behavior, output, or egress remains unknown"
  ],
  "expires_on": [
    "task-end",
    "policy-change",
    "helper-change"
  ]
}
